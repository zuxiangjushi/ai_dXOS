"""arXiv 论文适配器（v14.4修复）
- 修复：用 https 代替 http
"""
import re
import httpx
from typing import Dict, List


class ArxivAdapter:
    def __init__(self):
        # ★ 修复：https
        self.base = "https://export.arxiv.org/api/query"
        self.timeout = 20.0
        self.ua = "Memory-Gateway/1.0"

    def is_arxiv_query(self, query: str) -> bool:
        if not query:
            return False
        keywords = ["arXiv", "arxiv", "预印本", "论文", "学术", "研究", "paper", "preprint"]
        return any(kw in query for kw in keywords)

    def _extract_topic(self, query: str) -> str:
        q = query
        for p in ["arXiv", "arxiv", "搜索", "查找", "找一篇", "找", "关于", "的论文", "paper"]:
            q = q.replace(p, " ")
        return q.strip() or query

    async def search(self, query: str, limit: int = 5) -> List[Dict]:
        if not self.is_arxiv_query(query):
            return []

        topic = self._extract_topic(query)
        print(f"   [arxiv] 搜索: {topic}", flush=True)

        # ★ v14.5: 带重试（避免 429）
        text = ""
        for attempt in range(3):
            if attempt > 0:
                import asyncio as _a
                await _a.sleep(2 ** attempt)
                print(f"   [arxiv] 重试 {attempt}", flush=True)
            else:
                import asyncio as _a
                await _a.sleep(1)
            try:
                async with httpx.AsyncClient(timeout=self.timeout,
                                              headers={"User-Agent": self.ua},
                                              follow_redirects=True,
                                              proxy="socks5://127.0.0.1:12334") as c:
                    r = await c.get(self.base, params={"search_query": f"all:{topic}", "max_results": limit})
                    if r.status_code == 200:
                        text = r.text
                        break
                    print(f"   [arxiv] HTTP {r.status_code}", flush=True)
            except Exception as e:
                print(f"   [arxiv] {type(e).__name__}", flush=True)

        if not text:
            return []
        try:
                entries = re.findall(r'<entry>(.*?)</entry>', text, re.DOTALL)
                results = []
                for entry in entries[:limit]:
                    title_m = re.search(r'<title>(.*?)</title>', entry, re.DOTALL)
                    summary_m = re.search(r'<summary>(.*?)</summary>', entry, re.DOTALL)
                    link_m = re.search(r'<id>(.*?)</id>', entry, re.DOTALL)
                    if not title_m:
                        continue
                    title = title_m.group(1).strip().replace("\n", " ")[:100]
                    summary = summary_m.group(1).strip().replace("\n", " ")[:300] if summary_m else "无摘要"
                    url = link_m.group(1).strip() if link_m else "https://arxiv.org"
                    results.append({
                        "title": f"[arXiv] {title}",
                        "url": url,
                        "content": f"[arXiv] {title}\n摘要: {summary}",
                        "engine": "arxiv",
                        "authority": 0.85,
                    })
                print(f"   [arxiv] 返回 {len(results)} 条", flush=True)
                return results
        except Exception as e:
            print(f"   [arxiv] 失败: {type(e).__name__}: {e}", flush=True)
            return []


_instance = None
def get_arxiv() -> ArxivAdapter:
    global _instance
    if _instance is None:
        _instance = ArxivAdapter()
    return _instance
