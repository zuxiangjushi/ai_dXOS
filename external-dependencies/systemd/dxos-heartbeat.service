[Unit]
Description=Dxos_Pilot Heartbeat Service
Requires=dxos-backend.service
After=dxos-backend.service network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /ai/dxos_pilot/backend/heartbeat.py
Restart=always
RestartSec=5
TimeoutStopSec=30
WatchdogSec=60
StandardOutput=append:/var/log/dxos_heartbeat.log
StandardError=append:/var/log/dxos_heartbeat.log

[Install]
WantedBy=multi-user.target
